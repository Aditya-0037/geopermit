# ─────────────────────────────────────────────────────────────
# GeoPermit AI — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────────────────────

# ── GROQ AI (Case Resolution Agent — Required) ──────────────
# Free tier: https://console.groq.com/keys
# Model used: llama3-8b-8192 (fast, free, 6000 req/day)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── UiPath Maestro (Orchestrator — Required for HITL) ────────
# Found at: UiPath Cloud → Settings → API Access
UIPATH_TENANT_URL=https://cloud.uipath.com/your_org/your_tenant
UIPATH_CLIENT_ID=your_client_id_here
UIPATH_CLIENT_SECRET=your_client_secret_here
# Found at: Orchestrator → Admin → Folders → URL contains folder ID
UIPATH_FOLDER_ID=your_numeric_folder_id

# ── Application ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional: Email Notifications (Resend) ───────────────────
# Free tier: 100 emails/day → https://resend.com
# RESEND_API_KEY=re_xxxxxxx
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Optional: Production Deployment ──────────────────────────
# NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
# NEXTAUTH_URL=https://geopermit.vercel.app
